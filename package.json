{
  "name": "ironclash-arena",
  "private": true,
  "version": "1.0.0",
  "description": "IRONCLASH ARENA \u2013 a top-down 2.5D combat robot arena game for the browser.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/balanceSim.ts",
    "assets": "tsx scripts/renderAssets.ts",
    "prepare": "husky",
    "docs:balance": "tsx scripts/balanceDoc.ts",
    "i18n": "python3 scripts/i18n/build.py"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "matter-js": "0.20.0",
    "peerjs": "1.5.5",
    "phaser": "3.90.0",
    "preact": "10.29.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/matter-js": "0.20.2",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
