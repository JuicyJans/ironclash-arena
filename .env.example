# Base path for the build (GitHub Pages: /<repo-name>/). Defaults to './'.
VITE_BASE=./
# PeerJS signalling server. Leave empty to use the free PeerJS cloud server.
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
# Optional TURN server for players behind strict NATs (e.g. coturn).
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CREDENTIAL=
